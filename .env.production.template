# Copy once on the droplet: cp .env.production.template .env
# Do not commit .env. Hex secrets only (openssl rand -hex 32) — Redis/Evolution URIs.

NODE_ENV=production

DB_PASSWORD=
DB_NAME=nuvia
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres

PORT=3010

JWT_SECRET=
JWT_EXPIRES_IN=12h

# Panel origins (Vite on Vercel). Comma-separated, no trailing slash.
CORS_ORIGINS=https://nuvi.lat,https://www.nuvi.lat

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Compose overrides these to the Docker DNS names. Keep in sync with docker-compose.prod.yaml.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=http://evolution-api:8080
WEBHOOK_PUBLIC_URL=http://api:3010/api/v1/webhooks/whatsapp

WEBHOOK_SECRET=

LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.7-flash
# Gemini bills thinking as completion tokens, so this budget covers reasoning *and* the
# reply. At 512 the visible answer was cut mid-word (finish_reason=length) or never started.
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low
# Budget per attempt. OpenRouter answers 200 and pads the body while it waits on Google,
# so an upstream stall spends the whole budget; the attempt is retried once before the
# agent hands the conversation to a human. Healthy turns come back in a couple of seconds.
LLM_TIMEOUT_MS=30000
# Empty on purpose with a Gemini model: its zero data retention endpoint does not declare
# temperature, and provider.require_parameters then leaves no endpoint routable (404).
LLM_TEMPERATURE=
LLM_HTTP_REFERER=https://nuvi.lat
LLM_APP_TITLE=Nuvi
LLM_PROMPT_CACHE=true
LLM_PROMPT_CACHE_TTL=5m
LLM_SHORT_CIRCUIT_GREETINGS=true

# V1: files on the api_storage volume. S3 later (STORAGE_DRIVER=s3 + AWS_*).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage

# First owner: pass these with `docker compose exec -e … api yarn bootstrap:owner`.
# Do not leave BOOTSTRAP_PASSWORD in this file on the server.
BOOTSTRAP_TENANT_NAME=Nuvi
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_COUNTRY_CODE=BO
BOOTSTRAP_TIMEZONE=America/La_Paz
