# OpenRouter is the default provider (OpenAI-compatible protocol).
# LLM_MODEL must be a fixed OpenRouter slug that supports tools + tool_choice.
# Do not use auto-router for cost benchmarks; change only LLM_MODEL to try another model.
# Compare cost via agent_traces aggregates / GET admin/agent-traces/economics, not SaaS reply quota.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
# WhatsApp answers are short, but reasoning models bill thinking against this same budget:
# with one of those, keep it at 2048 or the reply gets cut mid-word (finish_reason=length).
LLM_MAX_TOKENS=512
# Defaults to 0.2. Leave empty to omit it and keep the provider default: endpoints that
# don't declare temperature (Gemini on Vertex, the zero data retention route) are dropped
# by require_parameters and OpenRouter answers 404.
LLM_TEMPERATURE=0.2
# low | medium | high, only for reasoning models on OpenRouter. Thinking bills as
# completion tokens, so low roughly halves it. Unset leaves the model default.
# LLM_REASONING_EFFORT=low
# Budget per attempt in ms (default 30000). A stalled attempt is retried once, so the
# client waits up to twice this before the agent hands off. Measure agent_traces
# duration_ms before raising it: a healthy turn answers in a couple of seconds.
# LLM_TIMEOUT_MS=30000
LLM_HTTP_REFERER=https://nuvi.app
LLM_APP_TITLE=Nuvi
# Prompt caching: explicit breakpoint on the stable system prompt (OpenRouter + Anthropic).
# Set false to roll back. Avoid top-level automatic cache_control with a volatile block.
LLM_PROMPT_CACHE=true
# 5m is the default; 1h costs more on write — only after measuring slow WhatsApp turns.
LLM_PROMPT_CACHE_TTL=5m
# Skip the LLM for pure greetings on a fresh chat. Set false to force the full agent.
LLM_SHORT_CIRCUIT_GREETINGS=true

# Fallbacks (optional):
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# local = filesystem (tests, offline dev) | s3 = the AWS bucket below
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ===========================================
# AWS S3 (only used when STORAGE_DRIVER=s3)
# ===========================================
# The credentials are read by the AWS SDK default chain, not by our code: keys here in
# development, an IAM role in production. Keep the bucket private, images are served
# through authenticated endpoints.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
